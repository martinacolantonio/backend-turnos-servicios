<h1>Listado de Servicios</h1>
<div id="services-container">
    <ul>
        {{#each services}}
            <li>
                <h3>{{this.name}}</h3>
                <p>{{this.description}}</p>
                <p><strong>Duración:</strong> {{this.duration}} mins</p>
                <p><strong>Precio:</strong> ${{this.price}}</p>
                <p><strong>Categoría:</strong> {{this.category}}</p>
            </li>
        {{/each}}
    </ul>
</div>